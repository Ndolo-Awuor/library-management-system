{
  "info": {
    "name": "PLP Library Week 2",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "email",
      "value": ""
    },
    {
      "key": "password",
      "value": ""
    },
    {
      "key": "bookId",
      "value": "1"
    },
    {
      "key": "genreId",
      "value": "1"
    },
    {
      "key": "borrowId",
      "value": "1"
    },
    {
      "key": "bookingId",
      "value": "1"
    }
  ],
  "item": [
    {
      "name": "Root health",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/"
      }
    },
    {
      "name": "List books",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/books?search=&page=1&limit=20"
      }
    },
    {
      "name": "Get books",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/books/{{bookId}}"
      }
    },
    {
      "name": "Create books (librarian)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}",
            "type": "text"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/books",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"New teaching book\",\n  \"author\": \"Adayo\",\n  \"isbn\": \"choose-a-new-isbn\",\n  \"description\": \"Class fixture\",\n  \"genreId\": 1,\n  \"totalCopies\": 2\n}"
        }
      }
    },
    {
      "name": "Update books (librarian)",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}",
            "type": "text"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/books/{{bookId}}",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Revised title\"\n}"
        }
      }
    },
    {
      "name": "Delete books (librarian)",
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}",
            "type": "text"
          }
        ],
        "url": "{{baseUrl}}/books/{{bookId}}"
      }
    },
    {
      "name": "List genres",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/genres"
      }
    },
    {
      "name": "Get genres",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/genres/{{genreId}}"
      }
    },
    {
      "name": "Create genres (librarian)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}",
            "type": "text"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/genres",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"New genre\",\n  \"slug\": \"new-genre\"\n}"
        }
      }
    },
    {
      "name": "Update genres (librarian)",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}",
            "type": "text"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/genres/{{genreId}}",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Revised genre\"\n}"
        }
      }
    },
    {
      "name": "Delete genres (librarian)",
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}",
            "type": "text"
          }
        ],
        "url": "{{baseUrl}}/genres/{{genreId}}"
      }
    },
    {
      "name": "register",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/auth/register",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}"
        }
      }
    },
    {
      "name": "login",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}"
        }
      }
    },
    {
      "name": "Current identity",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}",
            "type": "text"
          }
        ],
        "url": "{{baseUrl}}/auth/me"
      }
    },
    {
      "name": "Get user profile",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}",
            "type": "text"
          }
        ],
        "url": "{{baseUrl}}/users/profile"
      }
    }
  ]
}
